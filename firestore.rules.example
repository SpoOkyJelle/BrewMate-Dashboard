// Example Firestore rules for the BrewMate dashboard.
// Merge this into your project's rules (Firebase console → Firestore → Rules).
// It does NOT replace the per-user rules your app needs — keep those and add the admin parts.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admin list.
    // - Everyone may check their own entry (needed to see "you are not an admin").
    // - Admins may see the full list and add or remove other admins.
    // - Nobody can remove themselves, so there is always at least one admin left.
    // - Regular app users can never write here, so they cannot make themselves admin.
    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin()
        && request.resource.data.addedByUid == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    // Log of push messages sent from the dashboard. Only the Cloud Function writes here
    // (with the Admin SDK, which bypasses these rules); admins can read it.
    match /pushLog/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Ingeplande berichten, geblokkeerde gebruikers en het moderatielogboek.
    // Alleen de Cloud Functions schrijven hier; beheerders kunnen meekijken.
    match /scheduledPush/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /blockedUsers/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /moderationLog/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Guild events (contests). The BrewMate app AND the dashboard read these;
    // only the Cloud Functions write them (Admin SDK bypasses these rules).
    // THIS is what the Events page needs — without it the live list fails to load.
    match /events/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Monthly promotion/relegation locks, written by the rollover Cloud Function.
    match /leagueRollovers/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Guild leagues. Keep whatever guild WRITE rules your app already uses; the
    // important part here is that the app + dashboard can READ the guild doc and
    // its subcollections (members, seasonScores, history) for the leagues,
    // division detail, contributions and the promotion/relegation banner.
    match /guilds/{id} {
      allow read: if signedIn();
      // allow write: ... // <- keep your existing guild write rules
      match /{sub=**} {
        allow read: if signedIn();
      }
    }

    // Example: keep your existing app rules and make sure admins can read everything.
    match /users/{uid} {
      allow read: if signedIn();                       // app needs this for friends/search
      allow write: if signedIn() && request.auth.uid == uid;
    }
    match /beers/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn();                     // toasts are added by friends
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
    match /friends/{id} {
      allow read, write: if signedIn();
    }
    match /friendRequests/{id} {
      allow read, write: if signedIn();
    }
  }
}
